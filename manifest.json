{
    "name": "abhinav",
    "description": "abhinav extension",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
        "default_popup": "hi.html",
        "default_icon": "hi_extension.png"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "overlay.css"
            ]
        }
    ]
}